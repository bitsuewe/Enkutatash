# ===============================================
# Vercel Environment Variables Configuration
# Add these in: Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ===============================================

# Your Verify.ET API key from verify.et dashboard
VERIFY_ET_API_KEY=VERIFY_BANK_ET_your_key_here

# Your Telebirr Recipient Phone Number
MERCHANT_PHONE=0933894394

# Your Recipient Name (displayed to user)
MERCHANT_NAME=Bitsue Wolde

# Optional: Verify.ET API URL (default: https://verify.et)
VERIFY_ET_BASE_URL=https://verify.et
